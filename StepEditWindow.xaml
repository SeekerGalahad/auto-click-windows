<Window x:Class="AutoClickTool.StepEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoClickTool"
        mc:Ignorable="d"
        Title="编辑步骤" Height="300" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 步骤名称 -->
        <Label Grid.Row="0" Grid.Column="0" Content="步骤名称:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameTextBox" Margin="5" VerticalContentAlignment="Center"/>
        
        <!-- 坐标 -->
        <Label Grid.Row="1" Grid.Column="0" Content="X坐标:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="XCoordinateTextBox" Margin="5" VerticalContentAlignment="Center"/>
        
        <Label Grid.Row="2" Grid.Column="0" Content="Y坐标:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="YCoordinateTextBox" Margin="5" VerticalContentAlignment="Center"/>
        
        <!-- 点击类型 -->
        <Label Grid.Row="3" Grid.Column="0" Content="点击类型:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ClickTypeComboBox" Margin="5" VerticalContentAlignment="Center">
            <ComboBoxItem Content="左键单击"/>
            <ComboBoxItem Content="左键双击"/>
            <ComboBoxItem Content="右键单击"/>
            <ComboBoxItem Content="中键单击"/>
        </ComboBox>
        
        <!-- 延迟时间 -->
        <Label Grid.Row="4" Grid.Column="0" Content="延迟(毫秒):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="DelayTextBox" Margin="5" VerticalContentAlignment="Center"/>
        
        <!-- 循环次数 -->
        <Label Grid.Row="5" Grid.Column="0" Content="循环次数:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="LoopTextBox" Margin="5" VerticalContentAlignment="Center"/>
        
        <!-- 按钮 -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CaptureButton" Content="捕获坐标" Width="80" Margin="5,0" Click="CaptureButton_Click"/>
            <Button x:Name="SaveButton" Content="保存" Width="80" Margin="5,0" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Margin="5,0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>