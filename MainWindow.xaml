<Window x:Class="AutoClickTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoClickTool"
        mc:Ignorable="d"
        Title="自动点击工具" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 窗口选择区 -->
        <GroupBox Grid.Row="0" Header="目标窗口设置" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Label Grid.Row="0" Grid.Column="0" Content="窗口标题:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="WindowTitleTextBox" Margin="5" VerticalContentAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RefreshWindowsButton" Content="刷新窗口列表" Margin="5" Padding="5" Click="RefreshWindowsButton_Click"/>
                    <Button x:Name="ShowProcessListButton" Content="查看进程列表" Margin="5" Padding="5" Click="ShowProcessListButton_Click" ToolTip="查看当前运行的进程窗口列表"/>
                </StackPanel>
                
                <Label Grid.Row="1" Grid.Column="0" Content="分辨率:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ResolutionComboBox" Margin="5" VerticalContentAlignment="Center" IsEditable="True">
                    <ComboBoxItem Content="800x600"/>
                    <ComboBoxItem Content="1024x768"/>
                    <ComboBoxItem Content="1920x1080"/>
                    <ComboBoxItem Content="2560x1440"/>
                    <ComboBoxItem Content="3840x2160"/>
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="2" x:Name="VerifyResolutionButton" Content="验证分辨率" Margin="5" Padding="5" Click="VerifyResolutionButton_Click"/>
                
                <!-- 自适应分辨率选项 -->
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5">
                    <CheckBox x:Name="AdaptiveResolutionCheckBox" Content="启用自适应分辨率" VerticalAlignment="Center" IsChecked="True" ToolTip="启用后，点击坐标会根据实际窗口分辨率自动调整"/>
                    <Button x:Name="SetBaseResolutionButton" Content="设置当前分辨率为基准" Margin="10,0,0,0" Padding="5,2" Click="SetBaseResolutionButton_Click" ToolTip="使用当前窗口分辨率作为坐标的基准"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        
        <!-- 全局设置 -->
        <GroupBox Grid.Row="1" Header="全局设置" Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0" Content="全局间隔(毫秒):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="GlobalIntervalTextBox" Text="1000" Margin="5" VerticalContentAlignment="Center"/>
                
                <Label Grid.Column="2" Content="循环次数:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" x:Name="LoopCountTextBox" Text="1" Margin="5" VerticalContentAlignment="Center"/>
            </Grid>
        </GroupBox>
        
        <!-- 点击区域配置列表 -->
        <GroupBox Grid.Row="2" Header="点击区域配置" Margin="10,0,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                    <Button x:Name="AddStepButton" Content="添加步骤" Margin="5,0" Padding="5" Click="AddStepButton_Click"/>
                    <Button x:Name="EditStepButton" Content="编辑步骤" Margin="5,0" Padding="5" Click="EditStepButton_Click"/>
                    <Button x:Name="RemoveStepButton" Content="删除步骤" Margin="5,0" Padding="5" Click="RemoveStepButton_Click"/>
                    <Button x:Name="MoveUpButton" Content="上移" Margin="5,0" Padding="5" Click="MoveUpButton_Click"/>
                    <Button x:Name="MoveDownButton" Content="下移" Margin="5,0" Padding="5" Click="MoveDownButton_Click"/>
                    <Button x:Name="CaptureCoordinatesButton" Content="捕获坐标" Margin="5,0" Padding="5" Click="CaptureCoordinatesButton_Click"/>
                    <Button x:Name="StartRecordingButton" Content="开始录制" Margin="5,0" Padding="5" Click="StartRecordingButton_Click" ToolTip="直接录制对目标窗口的鼠标点击操作，结果会显示在下方列表中"/>
                </StackPanel>
                
                <ListView Grid.Row="1" x:Name="StepsListView" Margin="0,5,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="序号" DisplayMemberBinding="{Binding Index}" Width="40"/>
                            <GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="120"/>
                            <GridViewColumn Header="X坐标" DisplayMemberBinding="{Binding X}" Width="60"/>
                            <GridViewColumn Header="Y坐标" DisplayMemberBinding="{Binding Y}" Width="60"/>
                            <GridViewColumn Header="点击类型" DisplayMemberBinding="{Binding ClickType}" Width="80"/>
                            <GridViewColumn Header="延迟(毫秒)" DisplayMemberBinding="{Binding DelayBefore}" Width="80"/>
                            <GridViewColumn Header="循环次数" DisplayMemberBinding="{Binding Loop}" Width="60"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>
        
        <!-- 执行控制 -->
        <GroupBox Grid.Row="3" Header="执行控制" Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" x:Name="StartButton" Content="开始" Margin="5" Padding="5" Click="StartButton_Click"/>
                <Button Grid.Column="1" x:Name="PauseButton" Content="暂停" Margin="5" Padding="5" Click="PauseButton_Click" IsEnabled="False"/>
                <Button Grid.Column="2" x:Name="StopButton" Content="停止" Margin="5" Padding="5" Click="StopButton_Click" IsEnabled="False"/>
                
                <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock" Text="就绪" Margin="5" TextAlignment="Center"/>
                    <ProgressBar x:Name="ProgressBar" Height="15" Margin="5"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>